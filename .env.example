# MongoDB (e.g. a free MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/woo-ai-products

# OpenAI (text + image generation)
OPENAI_API_KEY=sk-...

# WooCommerce REST API (WooCommerce > Settings > Advanced > REST API)
# Leave these unset to run in "simulated publish" mode.
WOOCOMMERCE_SITE_URL=https://yourshop.com
WOOCOMMERCE_CONSUMER_KEY=ck_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...
